---
import Embed from '../components/Embed.astro';
import Base from '../layouts/Base.astro';
import { links } from '../lib/site';

if (!links.help) return new Response('Not found', { status: 404 });
---

<Base title="Help centre">
  <main class="mx-auto max-w-5xl px-6">
    <h1 class="mt-10 mb-6 font-serif text-5xl font-bold tracking-tight">Help centre</h1>
    <Embed page={`portal/${links.help}`} title="Help centre" />
  </main>
</Base>
