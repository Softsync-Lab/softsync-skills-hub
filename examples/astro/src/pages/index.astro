---
import PostCard from '../components/PostCard.astro';
import Base from '../layouts/Base.astro';
import { content, links, site } from '../lib/site';

const [posts, authors, schema] = await Promise.all([content().listPosts({ limit: 3 }), content().authors(), content().schema()]);
const doors = [
  { show: links.help, href: '/help', title: 'Help centre', text: 'Answers to the questions we hear most.' },
  { show: links.form, href: '/contact', title: 'Write to us', text: 'A message that reaches us straight away.' },
  { show: links.booking, href: '/book', title: 'Book a time', text: 'Pick a time that suits you.' },
].filter((door) => door.show);
---

<Base>
  <main class="mx-auto max-w-6xl px-6">
    <section class="py-16">
      <h1 class="font-serif text-6xl leading-none font-bold tracking-tight">{site.name}</h1>
      <p class="mt-4 max-w-xl text-xl text-stone-600">{site.tagline}</p>
    </section>
    {doors.length > 0 && (
      <section class="grid gap-4 sm:grid-cols-3">
        {doors.map((door) => (
          <a href={door.href} class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-stone-200 hover:ring-orange-600">
            <h2 class="font-semibold">{door.title}</h2>
            <p class="mt-1 text-stone-600">{door.text}</p>
          </a>
        ))}
      </section>
    )}
    <h2 class="mt-14 mb-6 text-sm font-semibold tracking-widest text-stone-500 uppercase">
      From the blog <a href="/blog" class="ml-2 font-normal tracking-normal normal-case underline">All articles</a>
    </h2>
    <div class="grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post: any) => <PostCard post={post} authors={authors} tags={schema.tags} />)}
    </div>
  </main>
</Base>
