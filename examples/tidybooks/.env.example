# Server only. The key can read your workspace: never ship it to the browser.
SOFTSYNC_API=https://api.softsync.ai
SOFTSYNC_API_KEY=
SOFTSYNC_APP=https://app.softsync.ai
SITE_URL=http://localhost:3000

# The public link of each page, as WORKSPACE_ID/LINK_ID, from its Embed or Add to website button.
# Leave one empty and that page (and its menu item) is left out.
SOFTSYNC_BOOKING=
SOFTSYNC_HELP=
SOFTSYNC_FORM=
SOFTSYNC_AGENT=

# While building: adds the line that lets you click any text on the site to edit it in the app.
SOFTSYNC_PREVIEW=
