# Read by the small server (server/server.mjs). The key never reaches the browser.
SOFTSYNC_API=https://api.softsync.ai
SOFTSYNC_API_KEY=
SITE_URL=http://localhost:8787
SITE_NAME=The Journal
SITE_TAGLINE=Stories, guides and ideas from our team
# Which public pages exist, for the sitemap (any value):
SOFTSYNC_HELP=
SOFTSYNC_FORM=
SOFTSYNC_BOOKING=

# Read by the browser app at build time (VITE_ values are public).
VITE_SOFTSYNC_APP=https://app.softsync.ai
VITE_SOFTSYNC_API=https://api.softsync.ai
# Each is WORKSPACE_ID/LINK_ID, as the app's Embed / Add to website buttons show.
# Leave one empty to hide that part of the site.
VITE_SOFTSYNC_FORM=
VITE_SOFTSYNC_BOOKING=
VITE_SOFTSYNC_HELP=
VITE_SOFTSYNC_AGENT=

# While you build: show drafts and pick up changes made in the app within seconds.
# Leave it empty (or 0) on the live site.
SOFTSYNC_PREVIEW=
